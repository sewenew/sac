LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WebSocket mode normally does not require these. Set them if the app uses
# event verification or encrypted event payloads.
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# Optional: POST each normalized event to another service.
LARK_FORWARD_URL=http://127.0.0.1:8080/agent/requests
LARK_FORWARD_TOKEN=
LARK_FORWARD_TIMEOUT_SECONDS=5

# Local open_id pairing and permission file.
LARK_PERMISSION_FILE=lark_permissions.json
LARK_PERMISSION_RELOAD_SECONDS=30
LARK_PAIRING_TTL_SECONDS=600

LOG_LEVEL=INFO
